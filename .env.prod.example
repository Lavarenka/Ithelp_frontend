# Переменные для docker-compose.prod.yml (сборка фронтенда, Postgres, SSL).
# Это НЕ те же переменные, что в backend_fastapi/.env — там отдельные секреты
# бэкенда (JWT, SMTP, reCAPTCHA, OAuth). Скопировать этот файл в .env.prod
# и заполнить перед первым запуском:
#   cp .env.prod.example .env.prod

# --- PostgreSQL ---
POSTGRES_DB=hlp
POSTGRES_USER=hlp
# Придумать стойкий пароль, например: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# --- Let's Encrypt / SSL (образ jonasal/nginx-certbot) ---
CERTBOT_EMAIL=

# 1 = тестовый режим Let's Encrypt: сертификат браузер НЕ будет считать
# доверенным, зато можно спокойно перезапускать контейнер сколько угодно
# раз, отлаживая конфиг, не упираясь в лимит запросов к реальному Let's
# Encrypt (он довольно низкий). Как только всё поднялось без ошибок —
# поставить 0 (или удалить строку) и перезапустить: docker compose -f docker-compose.prod.yml up -d --force-recreate nginx-certbot
STAGING=1

# --- Сборка фронтенда ---
# Адрес бэкенда СНАРУЖИ (через который браузер реально будет к нему ходить).
# Встраивается в JS во время сборки образа (см. hlp_react/Dockerfile) —
# при смене нужно пересобрать фронтенд-контейнер, не только перезапустить.
VITE_API_URL=https://api.yourdomain.example

# Публичный ключ сайта для Google reCAPTCHA (секретный — отдельно, в
# backend_fastapi/.env как RECAPTCHA_SECRET_KEY). Оба ключа — с
# https://www.google.com/recaptcha/admin, см. DEPLOY_CHECKLIST.md п.4.
VITE_RECAPTCHA_SITE_KEY=
