# Скопируй в .env и при необходимости поменяй значения.
# После изменения .env перезапусти `npm run dev` — Vite читает его только при старте.

# Адрес бэкенда (по умолчанию http://localhost:8000).
# VITE_API_URL=http://localhost:8000

# Google reCAPTCHA v2 «Я не робот» — ключ сайта (Site key, публичный).
# Создаётся на https://www.google.com/recaptcha/admin вместе с секретным ключом,
# который кладётся в backend_fastapi/.env как RECAPTCHA_SECRET_KEY.
# Если не заполнить — используется тестовый ключ Google (пропускает всех,
# только для локальной разработки!).
VITE_RECAPTCHA_SITE_KEY=6LfhtNEtAAAAAC4zHXYxWTfB7Fkj9YWVS9lBe8i5
