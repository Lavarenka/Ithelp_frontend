# Скопируй в .env и при необходимости поменяй значения.

# --- Вариант 1: SQLite (по умолчанию) ---
# Ничего ставить не нужно, файл базы hlp.db появится сам рядом с проектом.
DATABASE_URL=sqlite:///./hlp.db

# --- Вариант 2: PostgreSQL ---
# Когда поставишь PostgreSQL локально — закомментируй строку выше и раскомментируй эту:
# DATABASE_URL=postgresql+psycopg://hlp_dev:hlp_dev@localhost:5432/hlp_dev

# Через запятую — с каких адресов фронта разрешать запросы (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Секретный ключ для подписи JWT-токенов авторизации. Сгенерируй свой командой:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=2aad42145a0bdbc53b47b9ec233c3e52e882cca93669264b8eb0117ae5598cbb

# --- Письмо с подтверждением email при регистрации (см. app/mailer.py) ---
# Если оставить SMTP_HOST/SMTP_USERNAME/SMTP_PASSWORD пустыми — письма просто
# не будут отправляться (в лог уйдёт предупреждение), регистрация при этом
# всё равно работает: подтверждение email "мягкое" и не блокирует доступ.
#
# Для Gmail: SMTP_USERNAME — твой полный адрес (name@gmail.com), а
# SMTP_PASSWORD — НЕ обычный пароль от аккаунта, а App Password. Он создаётся
# на https://myaccount.google.com/apppasswords (нужна включённая двухэтапная
# аутентификация). Впиши 16-значный пароль без пробелов.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
# Необязательно — если не заполнено, письма идут от SMTP_USERNAME.
SMTP_FROM=
SMTP_FROM_NAME=it_hlp

# Адрес фронтенда — на него ведёт ссылка "Подтвердить email" в письме
# (страница /verify-email там сама обращается к API). Поменяй на реальный
# адрес сайта при деплое в продакшен.
FRONTEND_BASE_URL=http://localhost:5173

# --- Google reCAPTCHA v2 «Я не робот» (см. app/captcha.py) ---
# Ключи создаются на https://www.google.com/recaptcha/admin (тип: reCAPTCHA v2,
# «Я не робот»; домены: localhost и адрес сайта). Сюда — СЕКРЕТНЫЙ ключ
# (Secret key), а ключ сайта (Site key) — в hlp_react/.env как VITE_RECAPTCHA_SITE_KEY.
# Если не заполнить — используется тестовый ключ Google, который пропускает всех
# (только для локальной разработки!).
RECAPTCHA_SECRET_KEY=

# --- Вход через Google / GitHub (см. app/routers/oauth.py) ---
# Пусто — кнопка входа через этот сервис на сайте просто не показывается.
#
# Адрес самого бэкенда: из него собираются адреса возврата, которые нужно
# указать в настройках приложений Google/GitHub (должны совпадать В ТОЧНОСТИ):
#   {BACKEND_BASE_URL}/auth/oauth/google/callback
#   {BACKEND_BASE_URL}/auth/oauth/github/callback
BACKEND_BASE_URL=http://localhost:8000
#
# Google: https://console.cloud.google.com → APIs & Services →
#   «Экран согласия OAuth» (OAuth consent screen) — заполнить название сайта;
#   «Учётные данные» (Credentials) → «Создать» → «Идентификатор клиента OAuth»,
#   тип «Веб-приложение», в «Разрешённые URI перенаправления» — адрес выше.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# GitHub: https://github.com/settings/developers → OAuth Apps → New OAuth App,
#   Homepage URL — адрес фронтенда, Authorization callback URL — адрес выше.
#   Client secret генерируется кнопкой «Generate a new client secret».
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
